{
  "name": "spr-diff-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e:mock": "playwright test",
    "e2e:real": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:5173} playwright test",
    "check:openapi": "node scripts/check-openapi.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "vue": "^3.5.45"
  }
}
